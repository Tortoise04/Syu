  "cards": [
    {
      "dot": "cyan",
      "title": "依赖方向",
      "items": [
        "index → config / state / onebot / guard / collect / inbox",
        "guard 内部只有 pipeline 调下游：rules、screen、judge、action、sample、learn",
        "guard 不 import console，console 不 import guard"
      ]
    },
    {
      "dot": "emerald",
      "title": "外部可替换",
      "items": [
        "NapCat 换成任何 OneBot v11 实现，只改 ONEBOT_WS_URL",
        "Ollama 与 DeepSeek 换端点只改 config.json 的 baseUrl / model",
        "唯一运行时依赖 ws；没有框架、没有构建步骤"
      ]
    },
    {
      "dot": "amber",
      "title": "管理面边界",
      "items": [
        "控制台是独立进程，主进程崩了还能启停它",
        "进程只按 ExecutablePath 前缀识别，绝不按镜像名杀",
        "写操作要求回环来源 + x-syu-console 头"
      ]
    },
    {
      "dot": "rose",
      "title": "没画进来的两个模块",
      "items": [
        "guard/sample.ts：确定性抽样，被 pipeline 调",
        "guard/learn.ts：从举报 span 学词，进 gated 档",
        "两者都只被 pipeline 调用，画进来只增加一条同向边"
      ]
    }
  ]
