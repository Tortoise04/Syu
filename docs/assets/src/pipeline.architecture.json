  "cards": [
    {
      "dot": "cyan",
      "title": "三条通道",
      "items": [
        "直通云：命中 redline / rules.* / 链接词 / @机器人举报，直接终审",
        "本地确认：命中 gated 词，先让本地模型判断真伪，可疑才上云",
        "只记录：recordOnly 词、纯图片、粗筛 clean 未抽中，零云端成本"
      ]
    },
    {
      "dot": "amber",
      "title": "四道闸",
      "items": [
        "条款封顶 caps：照常送云，只压档位",
        "置信度阈值：低于阈值只记录，与出手同口径",
        "同群同人 5 分钟冷却；全局与单群预算任一满即不出手",
        "预算被拒记 budgetOut，不静默丢弃"
      ]
    },
    {
      "dot": "rose",
      "title": "降级不留空白",
      "items": [
        "粗筛没筛成 = unknown，不许当 clean 放行",
        "粗筛可疑但无证据 → 降 clean（举证式提示词闸门）",
        "云端不可达或非 JSON → 0 档 + degraded，宁漏不误伤"
      ]
    },
    {
      "dot": "emerald",
      "title": "可事后复算",
      "items": [
        "抽样用 sha1(groupId:messageId:salt) 前 8 位，同一条消息结果固定",
        "记录里写 roll / rate，任何人可离线复算为什么没送云",
        "violations 答“为什么这么判”，sent 答“到底说了什么”"
      ]
    }
  ]
