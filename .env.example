# 复制成 .env 再填；.env 不进仓库、不同步（已在 .gitignore / .stignore 里排除）

# OneBot v11 正向 WS 地址：NapCat 开「WebSocket 服务器」的端口
# 端口分工（服务器部署）：3001 是服务器上 Dyu 的 NapCat，本机器人用 3002
ONEBOT_WS_URL=ws://127.0.0.1:3002

# NapCat 的 access_token，没设就留空
ONEBOT_TOKEN=

# 要守卫的群号，多个用逗号/空格分隔（只守这些群，其他群的消息入口就丢掉）；留空会启动失败
# 例：GUARD_GROUP_IDS=20001,20002（写纯数字群号，两个号之间只隔逗号或空格）
GUARD_GROUP_IDS=

# 主人 QQ 号（纯数字）：3 级动作的证据私聊发给这个号；私聊失败时群内会 @这个号 提示
# 必填，缺失即启动失败；不写真实号，自己填
OWNER_QQ=

# 管理员 QQ 号（可留空）：和 config.json 的 notify.adminQqs 合并，只多收提醒、不豁免，
# 但会进运维名单（能发控制台命令）。不写真实号，自己填
ADMIN_QQ=

# 通知人 QQ 号（可留空）：和 config.json 的 notify.recipients 合并。只收提醒（通知类 + 3 级证据），
# 零权限——不进运维名单、不豁免、不收私聊收件箱
NOTIFY_QQ=

# 日志级别：debug | info | warn | error
LOG_LEVEL=info

# mock 模式：把收到的原始事件全打出来，方便对着 scripts/mock-onebot.mjs 调；线上务必 0
MOCK_MODE=0

# 关键词表 / 阈值 / 预算 / Ollama 与 DeepSeek 端点 / 链接白名单 / 群规原文 / 动作开关都在 config.json
# 动作开关在 config.json 的 actions 一节：dryRun 默认 true（只打日志不发消息），真上线才改 false
# 只有想换配置文件名（测试、多实例）才改这里；默认就是工程根目录的 config.json
GUARD_CONFIG_PATH=config.json

# DeepSeek 密钥：只放这里（config.json 会同步到两端，不许写密钥）
DEEPSEEK_API_KEY=
